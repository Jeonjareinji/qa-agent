# ========================================================
# QA Agent — .gitignore
# Mengabaikan file dependensi, kredensial, build, dan media
# ========================================================

# --- 1. Dependencies (Paket Node.js) ---
# Mengabaikan seluruh folder node_modules di root maupun subfolder
node_modules/
backend/node_modules/
frontend/node_modules/

# --- 2. Environment Variables & Rahasia ---
# Jangan pernah commit file kredensial/token asli ke git
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local

# Tetap sertakan file template contoh ke git
!.env.example
!backend/.env.example
!frontend/.env.example

# --- 3. Build & Output Produksi ---
# Hasil build aplikasi frontend Vite / TypeScript
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
*.tsbuildinfo

# --- 4. File Upload & Media Bukti (Evidence) ---
# File fisik gambar, video, dan lampiran pengujian yang diunggah
uploads/
backend/uploads/
!uploads/.gitkeep
!backend/uploads/.gitkeep

# --- 5. Folder Arsip / Migrasi Sementara ---
# Folder cadangan pembaruan frontend yang sudah disortir
fe_update/

# --- 6. Log & Debugging ---
# Log proses npm, yarn, dan server
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 7. Sistem Operasi (OS) & Cache Editor/IDE ---
# File metadata macOS & Windows
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Konfigurasi editor lokal (VSCode, JetBrains, vim)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
