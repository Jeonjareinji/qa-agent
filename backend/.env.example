# Port Server Backend (default: 8787, sesuaikan dengan proxy frontend)
PORT=8787

# URL Koneksi PostgreSQL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qa_agent

# Token Bot Telegram dari @BotFather
BOT_TOKEN=

# URL WebApp publik (wajib HTTPS untuk Telegram Mini App di production)
WEBAPP_URL=https://example.com

# User ID default saat testing lokal di browser biasa (tanpa Telegram)
DEV_USER_ID=1001

# Direktori penyimpanan file upload (foto, video, evidence)
UPLOAD_DIR=./uploads

# Opsional: Batasi hanya Telegram User ID tertentu yang boleh akses (pisahkan koma)
ALLOWED_USER_IDS=

